# Morning Brief configuration.
# Copy to config.env, then: chmod 600 config.env
# config.env is gitignored. Never commit it.

# Telegram (create a bot with @BotFather; get the chat id with ./brief chat-id)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Claude model alias. Sonnet is lighter on Pro usage limits.
MODEL="sonnet"

# Daily run time (local time; the Mac should be on Asia/Kolkata)
RUN_HOUR=6
RUN_MINUTE=0

# Hard timeout for the claude run, in seconds
MAX_SECONDS=2400

# Absolute path to the claude binary. Filled in by ./brief install (command -v claude).
CLAUDE_BIN=""

# "Closing soon" window, in days
CLOSING_SOON_DAYS=3

# Forget sent items after this many days (unless their deadline is still ahead)
SEEN_RETENTION_DAYS=120

# Catch-up and retry. If 06:00 was missed (Mac off, asleep or logged out) or the run failed,
# the brief runs at your next login/wake, then retries every RETRY_MINUTES,
# at most MAX_DAILY_ATTEMPTS times a day. Rerun ./brief install after changing RETRY_MINUTES.
MAX_DAILY_ATTEMPTS=3
RETRY_MINUTES=30
